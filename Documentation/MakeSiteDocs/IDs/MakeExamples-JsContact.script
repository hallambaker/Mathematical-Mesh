#method WriteBytesHex byte[] data
#if (data != null)
#{data.ToStringBase16FormatHex()}
#else
$$$ Missing data $$$
#end if
#end method


#method2 CardExample string parent JsonObject example
{
    "@type":"Card",
    ...
    "#{parent}" : #!
#{JSONDebugWriter.Write(example, true, 2)},
    ...
    }
#end method2


#method3 CardExample string parent JsonObject example1 JsonObject example2
{
  "@type":"Card",
  ...
  "#{parent}" : #!
#{JSONDebugWriter.Write(example1, true, 2)},
  ...
#{JSONDebugWriter.Write(example2, true, 2)},
  ...
  }
~~~~
#end method3


#method StartCard bool ignore=true
~~~~
{
  "@type":"Card",
  ...
#end method

#method EndCard bool ignore=true
  }
~~~~
#end method

#zfile CreateExamples JSContactKeys "Examples\\JSContactKeys.md" Example
