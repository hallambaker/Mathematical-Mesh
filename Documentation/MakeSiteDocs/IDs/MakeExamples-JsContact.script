#method2 Write Dictionary<string,OnlineService> services bool part=false
{
    "@type":"Card",
    ...
    "onlineServices" : {#!
#% var sep = new Separator (",\n");
#foreach (var service in services)
#{sep}#!
"#{service.Key}" : #{JSONDebugWriter.Write(service.Value, false)}#!
#end foreach
#if (part) 

...
#end if
}
#end method2

#method2 Write Dictionary<string,CryptoKey> jsonKeys bool part=false
{
    "@type":"Card",
    ...
    "cryptoKeys" : {#!
#% var sep = new Separator  (",\n");
#foreach (var jsonKey in jsonKeys)
#{sep}#!
"#{jsonKey.Key}" : #{JSONDebugWriter.Write(jsonKey.Value, false)}#!
#end foreach
#if (part) 

...
#end if
}
#end method2

#method WriteUpdates Dictionary<string,Update> jsonKeys
    "updates" : {
#% var sep = new Separator  (",\n");
#foreach (var jsonKey in jsonKeys)
#{sep}#!
"#{jsonKey.Key}" : #{JSONDebugWriter.Write(jsonKey.Value, false)}#!
#end foreach
}
#end method


#method WriteCryptoKeys Dictionary<string,CryptoKey> jsonKeys
    "cryptoKeys" : {
#% var sep = new Separator  (",\n");
#foreach (var jsonKey in jsonKeys)
#{sep}#!
"#{jsonKey.Key}" : #{JSONDebugWriter.Write(jsonKey.Value, false)}#!
#end foreach
}
#end method


#end xclass
