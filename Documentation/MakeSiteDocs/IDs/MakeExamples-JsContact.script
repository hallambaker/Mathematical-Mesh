#% #pragma warning disable IDE0022
#% #pragma warning disable IDE0060
#% #pragma warning disable IDE1006
#xclass ExampleGenerator CreateExamples



#method MakeJSContactExamples CreateExamples Example
#% JSContactSchema(Example);
#% JSContactKeys(Example);
#% JSContactJWK(Example);
#% JSContactEARL(Example);
#% JSContactDNS(Example);
#% JSContactGroups(Example);
#% JSContactUpdate(Example);
#% JSContactSMIME(Example);
#% JSContactOpenPGP(Example);
#% JSContactSSH(Example);
#% JSContactCode(Example);
#% JSContactCommit(Example);
#end method


#method WriteBytesHex byte[] data
#if (data != null)
#{data.ToStringBase16FormatHex()}
#else
$$$ Missing data $$$
#end if
#end method







#method2 CardExample string parent JsonObject example
{
    "@type":"Card",
    ...
    "#{parent}" : #!
#{JSONDebugWriter.Write(example)},
    ...
    }
#end method2

#zfile CreateExamples JSContactSchema "Examples\\JSContactSchema.md" Example
#% var jscontact = Example.JSContact;

#### Additional Card Properties

The following properties are added to the Card object specified in [RFC9553].

#% jscontact.AnnotatedSchema.DocumentProperties(_Output, "Card",[ "Updates", "Groups"]);


#%

#### Extended Objects

The following objects specified in [RFC9553] are extended to add the specified properties.

#% jscontact.AnnotatedSchema.DocumentStructure(_Output, "EmailAddress", ["CryptoKeyIds"]);
#% jscontact.AnnotatedSchema.DocumentStructure(_Output, "OnlineService", ["CryptoKeyIds"]);

#### New Objects

The following object is defined:

#% jscontact.AnnotatedSchema.DocumentStructure(_Output, "JsonWebKeySet");

#end zfile



#zfile CreateExamples JSContactKeys "Examples\\JSContactKeys.md" Example
#% var jscontact = Example.JSContact;
#% // For example, Bob is trying to send an encrypted email to Alice, her 
#% //contact card lists two X.509v3 certificates but only one is an encryption 
#% // certificate with the JWK use parameter:
~~~~
#!{JSONDebugWriter.Write(jscontact.EmailAddress)}
#% CardExample ("emails", jscontact.EmailAddress);
~~~~
#end zfile

#zfile CreateExamples JSContactJWK "Examples\\JSContactJWK.md" Example
#% var jscontact = Example.JSContact;
~~~~
#% Write(jscontact.JSContactSmime, true);
~~~~
#end zfile

#zfile CreateExamples JSContactEARL "Examples\\JSContactEARL.md" Example
#% var jscontact = Example.JSContact;
#% var earl = Example.Earl;
~~~~
#{jscontact.EARL}
~~~~
#end zfile

#zfile CreateExamples JSContactDNS "Examples\\JSContactDNS.md" Example
#% var jscontact = Example.JSContact;
#% var earl = Example.Earl;
~~~~
_jscontact.#{CreateExamples.DnsHandleAlice} TXT "jscontact=#{jscontact.EARL}"
~~~~
#end zfile

#zfile CreateExamples JSContactGroups "Examples\\JSContactGroups.md" Example
#% var jscontact = Example.JSContact;
~~~~
#! {JSONDebugWriter.Write(jscontact.Group)}
#% CardExample ("groups", jscontact.Group);
~~~~

Each group identifier is specified as an online service:

~~~~
#% Write(jscontact.GroupMembers, true);
~~~~
#end zfile

