#method2 WriteTags JsContact contact List<string> include
#% StartCard ();
#% var trail = true;
#% WriteOut ("updates", contact.ServiceGroups, include, ref trail);
#% WriteOut ("serviceGroups", contact.ServiceGroups, include, ref trail, last:true);
#% WriteOut ("emails", contact.Emails, include, ref trail);
#% WriteOut ("onlineServices", contact.OnlineServices, include, ref trail);
#% WriteOut ("cryptoKeys", contact.CryptoKeys, include, ref trail, last:true);
#% EndCard ();
#end method2


#block
#% public void WriteOut<T> (string tag, Dictionary<string,T> entries, 
#%      List<string> include, ref bool trail, bool last=false) 
#%      where T : JsonObject {
#if (JsContactResults.IsEmpty (include, entries)) 
#! [Suppress #{tag}]
#if trail
    ...
#% trail = false;
#end if
#% return;
#end if
  "#{tag}" : {
#% var dots = true;
#foreach (var entry in entries) 
#if (JsContactResults.IsIncluded (include, entry.Key)) 
#% dots = true;
    "#{entry.Key}" : #!
#{JSONDebugWriter.Write(entry.Value, false, 3)}
#elseif (dots) 
#% dots = false;
    ...
#end if
#end foreach
#if last
    }
#else
    },
#end if
#% }
#end block





#method2 Write Dictionary<string,OnlineService> services bool part=false
{
    "@type":"Card",
    ...
    "onlineServices" : {#!
#% var sep = new Separator (",\n");
#foreach (var service in services)
#{sep}#!
"#{service.Key}" : #{JSONDebugWriter.Write(service.Value, false)}#!
#end foreach
#if (part) 

...
#end if
}
#end method2

#method2 Write Dictionary<string,CryptoKey> jsonKeys bool part=false
{
    "@type":"Card",
    ...
    "cryptoKeys" : {#!
#% var sep = new Separator  (",\n");
#foreach (var jsonKey in jsonKeys)
#{sep}#!
"#{jsonKey.Key}" : #{JSONDebugWriter.Write(jsonKey.Value, false)}#!
#end foreach
#if (part) 

...
#end if
}
#end method2





#method WriteEmails Dictionary<string,EmailAddress> jsonKeys
    "emails" : {
#% var sep = new Separator  (",\n");
#foreach (var jsonKey in jsonKeys)
#{sep}#!
      "#{jsonKey.Key}" : #{JSONDebugWriter.Write(jsonKey.Value, false,4)}#!
#end foreach
}
#end method


#method WriteUpdates Dictionary<string,Update> jsonKeys
    "updates" : {
#% var sep = new Separator  (",\n");
#foreach (var jsonKey in jsonKeys)
#{sep}#!
      "#{jsonKey.Key}" : #{JSONDebugWriter.Write(jsonKey.Value, false,4)}#!
#end foreach
}
#end method


#method WriteCryptoKeys Dictionary<string,CryptoKey> jsonKeys
    "cryptoKeys" : {
#% var sep = new Separator  (",\n");
#foreach (var jsonKey in jsonKeys)
#{sep}#!
      "#{jsonKey.Key}" : #{JSONDebugWriter.Write(jsonKey.Value, false,4)}#!
#end foreach
}
#end method


