Protocol Goedel.Cryptography.Jose  Jose Jose

	Description
		|Support classes for JSON Object Signing and Encryption

	Structure JoseWebSignature
		Description
			|A signed JOSE data object. The data contents are all binary encoded to 
			|enable direct authentication of the contents.
		// Parametric Object
		Struct Header Unprotected
			Tag "unprotected"
			Description
				|Data not protected by the signature
		Binary Payload
			Tag "payload"
			Description
				|The signed data
		Struct Signature Signatures
			Multiple
			Tag "signatures"
			Description
				|The signature value
	

	Structure JoseWebEncryption
		Inherits JoseWebSignature

		Description
			|A signed JOSE data object. The encrypted data contents are all binary encoded.

		// Parametric Object

		Binary Protected
			Tag "protected"
			Description
				|Data protected by the signature

		Binary IV
			Tag "iv"
			Description
				|The initialization vector for the bulk cipher.
		Struct Recipient Recipients
			Tag "recipients"
			Multiple
			Description
				|Per recipient decryption data.
		Binary EncryptedKey 
			Tag "encrypted_key"
			Description
				|The decryption data for use by this recipient.
		Binary AdditionalAuthenticatedData
			Tag "aad"
			Description
				|Additional data that is included in the authentication scope but not the encryption
		Binary CipherText
			Tag "ciphertext"
			Description
				|The encrypted data
		Binary JTag
			Tag "tag"
			Description
				|Authentication tag



	Structure JWKS
		CamelCase
		Struct JWK Keys 
			Multiple

	Structure JWK
		CamelCase
		String KeyType
			Tag "kty"
			TypeTag
		String Use 
			Tag "use"
		String KeyOps
			Tag "key_ops"
		String Alg 
		String Kid 
		Binary X5u
			Tag "x5u"
		Binary X5T
			Tag "x5t"
		Binary X5T256
			Tag "x5t#S256"

		//String Curve
		//	Tag "crv"
		//String X 
		//String Y 
		//String D 

		//String N
		//String E 


	Structure JwkEllipticCurve
		CamelCase
		Tag "EC"
		Inherits JWK
		String Curve
			Tag "crv"
			Description
				|The "crv" (curve) parameter identifies the cryptographic curve used
				|with the key
		String X 
			Description
				|The "x" (x coordinate) parameter contains the x coordinate for the
				|Elliptic Curve point.
		String Y 		
			Description
				|The "y" (y coordinate) parameter contains the y coordinate for the
				|Elliptic Curve point.
		String D 	
			Description
				|The "d" (ECC private key) parameter contains the Elliptic Curve
				|private key value.

	Structure JwkRsa
		CamelCase
		Tag "RSA"
		Inherits JWK

		String N	
			Description
				|
		String E 	
			Description
				|

	Structure JwkRsaPrivate
		CamelCase
		Inherits PublicKeyRSA
		Binary D
			Tag "d"
			Description
				|The parameter d
		Binary P
			Tag "p"
			Description
				|The parameter p
		Binary Q
			Tag "q"
			Description
				|The parameter q
		Binary DP
			Tag "dp"
			Description
				|The parameter dp
		Binary DQ
			Tag "dq"
			Description
				|The parameter dq
		Binary QI
			Tag "qi"
			Description
				|The parameter QInverse

	Structure JwkUdfSeed
		CamelCase
		Tag "UDFS"
		Inherits JWK

		String Seed
			Tag "seed"
			Description
				|
		String Roots
			Tag "roots"
			Multiple
			Description
				|

	Structure JwkOctet
		CamelCase
		Tag "oct"
		Inherits JWK

	Structure JwkOctetKeyPairs
		CamelCase
		Tag "OKP"
		Inherits JWK

		String Curve
			Tag "crv"
			Description
				|MUST be present and contain the subtype of the key 
				|(from the "JSON Web Elliptic Curve" registry)
		String X 
			Description
				|MUST be present and contain the public key
				|encoded using the base64url [RFC4648] encoding.
		String D 
			Description
				|MUST be present for private keys and contain the
				|private key encoded using the base64url encoding.  This parameter
				|MUST NOT be present for public keys.

	Structure JwtHeader
		String Typ
			Tag "typ"
			Description
				|Another IANA content type parameter
		String Alg
			Tag "alg"
			Description
				|Key exchange algorithm
		Struct JWK Jwk
			Tag "jwk"	
			Description
				|JSON Web Key	


	Structure Signed
		Description
			|Compact representation for signed data

		Binary Protected
			Tag "protected"
			Description
				|Data protected by the signature
		Binary Payload
			Tag "payload"
			Description
				|The authenticated data
		Binary Signature
			Tag "signature"
			Description
				|The signature data

	Structure Encrypted
		Description
			|Compact representation for encrypted data

		Struct Header Header
			Tag "header"
			Description
				|Header
		Binary IV
			Tag "iv"
			Description
				|The initialization vector for the cipher
		Binary CipherText
			Tag "ciphertext"
			Description
				|The encrypted data 
		Binary Signature
			Tag "signature"
			Description
				|The signature data

	Structure JsonWebKeys
		CamelCase
		Struct KeyCore Keys 
			Multiple

	Structure KeyCore
		Description
			|Describe a cryptographic key
		String Enc
			Tag "enc"
			Description
				|Bulk encryption algorithm for content
		String Dig
			Tag "dig"
			Description
				|Digest algorithm hint
		String Alg
			Tag "alg"
			Description
				|Key exchange algorithm
		String Kid
			Tag "kid"
			Description
				|Key identifier. If a UDF fingerprint is used to identify the 
				|key it is placed in this field.
		String X5u
			Tag "x5u"
			Description
				|URL identifying an X.509 public key certificate
		Binary X5c
			Tag "x5c"
			Description
				|An X.509 public key certificate
		Binary X5t
			Tag "x5t"
			Description
				|SHA-1 fingerprint of X.509 certificate
		Binary X5tS256
			Tag "x5t#S256"
			Description
				|SHA-2-256 fingerprint of X.509 certificate


	Structure Header
		Description
			|A JOSE Header.
		Inherits KeyCore

		String Jku
			Tag "jku"
			Description
				|JWK Set URL
		TStruct Key Jwk
			Tag "jwk"
			Description
				|The key parameters
		TStruct Key Epk
			Tag "epk"
			Description
				|The key parameters of the ephemeral key
		Binary Ek
			Tag "ek"
			Description
				|Binary cryptographic exchange parameters
		String Typ
			Tag "typ"
			Description
				|Another IANA content type parameter
		String Cty
			Tag "cty"
			Description
				|Content type parameter
		String Crit
			Tag "crit"
			Multiple
			Description
				|List of header parameters that a recipient MUST understand to interpret
				|the authentication portion of the JOSE object.
		Binary Val
			Tag "val"
			Description
				|The digest value

	Structure Signature
		Description
			|The signature value
		Struct Header Header
			Tag "header"
			Description
				|The signature header
		Binary Protected
			Tag "protected"
			Description
				|Data protected by the signature
		Binary SignatureValue
			Tag "signature"
			Description
				|The signature value


	Structure KeyContainer
		Description
			|A wrapper object for storing key data.
		Boolean Exportable
			Description
				|If false a handler library MUST NOT permit the private key to be exported.
		Binary KeyCore
			Description
				|The key data.

			


	Structure Key
		Description
			|A JOSE key. All fields map onto the equivalent fields defined in
			|RFC 7517
		Inherits KeyCore
		Boolean Exportable
			Description
				|If true, a stored key may be exported from the machine on 
				|which it is stored.
		String Kty
			Tag "kty"
			Description
				|Key type
		String Use
			Tag "use"
			Description
				|Public Key use
		String Key_ops
			Tag "key_ops"
			Multiple
			Description
				|Key operations


		Binary K
			Tag "k"
			Description
				|Symmetric key value.


	Structure Recipient
		Description
			|Recipient information
		Struct Header Header
			Description
				|Specify the recipient and per recipient data
		Binary EncryptedKey
			Tag "encrypted_key"
			Description
				|The decryption data for use by this recipient.

	Structure PublicKeyRSA
		Description
			|An RSA Public key
		Inherits Key
		Binary N
			Tag "n"
			Description
				|The public modulus
		Binary E
			Tag "e"
			Description
				|The public exponent

	Structure PrivateKeyRSA
		Description
			|RSA private key parameters
		Inherits PublicKeyRSA
		Binary D
			Tag "d"
			Description
				|The parameter d
		Binary P
			Tag "p"
			Description
				|The parameter p
		Binary Q
			Tag "q"
			Description
				|The parameter q
		Binary DP
			Tag "dp"
			Description
				|The parameter dp
		Binary DQ
			Tag "dq"
			Description
				|The parameter dq
		Binary QI
			Tag "qi"
			Description
				|The parameter QInverse

	Structure PublicKeyDH
		Description
			|A Diffie Helllman Public key
		Inherits Key
		Binary Domain
			Description
				|The fingerprint of the domain
		Binary Public
			Description
				|The public key

	Structure PrivateKeyDH
		Description
			|Diffie Helllman private key parameters
		Inherits PublicKeyDH
		Binary Private
			Description
				|The private key.

	Structure PublicKeyECDH
		Description
			|An Elliptic Curve Diffie Hellman public key
		Inherits Key
		String Curve
			Tag "crv"
			Description
				|The curve specifier (X25519, Ed25519, X448, Ed448), etc.
		Binary Public
			Description
				|The public key
	
	Structure PrivateKeyECDH
		Description
			|Diffie Helllman private key parameters
		Inherits PublicKeyECDH
		Binary Private
			Description
				|The private key

	Structure PrivateKeyUDF
		Inherits Key
		Description
			|A UDF Key
		String PrivateValue
			Description
				|The private value
		String KeyType
			Description
				|The UDF key identifier
		String RootSignAlgorithms
			Multiple
			Description
				|List of algorithms used to derrive root signature keys.
		String AlgorithmEncrypt
			Description
				|The algorithm used to derrive the encryption key
		String AlgorithmSign
			Description
				|The algorithm used to derrive the signature key
		String AlgorithmAuthenticate
			Description
				|The algorithm used to derrive the authentication key

	Structure KeyAgreement
		Description
			|Result of applying a key agreement.

	Structure KeyAgreementDH
		Description
			|Result of applying a key agreement.
		Inherits KeyAgreement
		Binary Result
			Description
				|The result


	Structure KeyAgreementECDH
		Description
			|Result of applying a key agreement.
		Inherits KeyAgreement
		String Curve
			Description
				|The curve name
		Binary Result
			Description
				|The result

	Structure PublicKeyBinary
		Inherits Key
		Description
			|A public key represented as a binary blob whose type is specified
			|by Kty.
		Binary Public
			Description
				|The public key value

	Structure PrivateKeyBinary
		Inherits Key
		Description
			|A private key represented as a binary blob whose type is specified
			|by Kty.
		Binary Public
			Description
				|The private key value


